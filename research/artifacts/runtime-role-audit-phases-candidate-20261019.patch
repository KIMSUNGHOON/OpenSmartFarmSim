+"""Actual current audits with bounded catalog round trips and original matrices."""
+import pytest
+from dataclasses import replace
+from psycopg import sql
+
+from app.runtime_login import connect_runtime
+from app.runtime_roles import audit_runtime_roles, RolePolicyHold
+from test_runtime_role_matrix import (
+    login_database, original_login_scope, login_scope, selected_policy,
+    matrix_cleanup, matrix_kind)
+
+pytestmark = [selected_policy, pytest.mark.usefixtures('matrix_cleanup')]
+
+
+@pytest.mark.parametrize('login_scope', [True, False], indirect=True)
+def test_current_audit_has_four_reads_and_unchanged_empty_matrices(login_scope):
+    _, policy, dsns = login_scope
+    observed = []
+
+    class Reads:
+        def __init__(self, conn): self.conn = conn
+        def __getattr__(self, name): return getattr(self.conn, name)
+        def execute(self, query, params=None):
+            assert isinstance(query, str) and query.lstrip().split(None, 1)[0].upper() in {'WITH', 'SELECT'}
+            result = self.conn.execute(query, params)
+            observed.append((matrix_kind(query), result.rowcount))
+            return result
+
+    with connect_runtime(dsns['authority'], policy, 'authority') as conn:
+        result = audit_runtime_roles(Reads(conn), policy)
+    assert result['roles'] == policy.roles and result['tables'] >= 26
+    assert [(kind, count) for kind, count in observed if kind] == [('table', 0), ('column', 0)]
+    assert len(observed) == 4
+
+
+@pytest.mark.parametrize('fault,reason', [
+    ('database', 'runtime_database_scope_mismatch'),
+    ('schema', 'dedicated_nonruntime_owner_required'),
+    ('owner_name', 'dedicated_nonruntime_owner_required'),
+    ('owner_login', 'dedicated_nonruntime_owner_required'),
+    ('owner_escape', 'owner_not_dedicated_to_project'),
+    ('creator', 'uncontrolled_project_creators'),
+    ('missing_table', 'unexpected_project_objects_or_owners'),
+    ('table_owner', 'unexpected_project_objects_or_owners'),
+    ('usage', 'runtime_ddl_or_definer_escape'),
+])
+def test_consolidated_scope_keeps_current_holds(login_scope, fault, reason):
+    base, policy, dsns = login_scope
+    selected = policy
+    restore = None
+    owner, role = sql.Identifier(policy.owner), sql.Identifier(policy.roles['authority'])
+    schema = sql.Identifier(policy.schema)
+    target = sql.Identifier(policy.schema, 'ai_decisions')
+    if fault in {'database', 'schema', 'owner_name'}:
+        field = {'owner_name': 'owner'}.get(fault, fault)
+        selected = replace(policy, **{field: 'absent_audit_phase_scope'})
+        command = None
+    elif fault == 'owner_login':
+        command = sql.SQL('ALTER ROLE {} LOGIN').format(owner)
+        restore = sql.SQL('ALTER ROLE {} NOLOGIN').format(owner)
+    elif fault == 'owner_escape':
+        outside = sql.Identifier(policy.schema + '_outside')
+        command = sql.SQL('CREATE SCHEMA {} AUTHORIZATION {}').format(outside, owner)
+        restore = sql.SQL('DROP SCHEMA {}').format(outside)
+    elif fault == 'creator':
+        command = sql.SQL('GRANT CREATE ON SCHEMA {} TO {}').format(schema, role)
+        restore = sql.SQL('REVOKE CREATE ON SCHEMA {} FROM {}').format(schema, role)
+    elif fault == 'missing_table':
+        command = sql.SQL('ALTER TABLE {} RENAME TO absent_audit_phase_table').format(target)
+        restore = sql.SQL('ALTER TABLE {} RENAME TO ai_decisions').format(
+            sql.Identifier(policy.schema, 'absent_audit_phase_table'))
+    elif fault == 'table_owner':
+        command = sql.SQL('ALTER TABLE {} OWNER TO {}').format(target, role)
+        restore = sql.SQL('ALTER TABLE {} OWNER TO {}').format(target, owner)
+    else:
+        command = sql.SQL('REVOKE USAGE ON SCHEMA {} FROM {}').format(schema, role)
+        restore = sql.SQL('GRANT USAGE ON SCHEMA {} TO {}').format(schema, role)
+    with connect_runtime(dsns['authority'], policy, 'authority') as conn:
+        try:
+            if command is not None:
+                with base.connect() as admin: admin.execute(command)
+            with pytest.raises(RolePolicyHold, match='^' + reason + '$'):
+                audit_runtime_roles(conn, selected)
+        finally:
+            if restore is not None:
+                with base.connect() as admin: admin.execute(restore)

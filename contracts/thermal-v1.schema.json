  "required": [
    "contract_version",
    "model_origin",
    "claim_scope",
    "run_status",
    "scope",
    "run_id",
    "trace_id",
    "trace_sequence_index",
    "input_snapshot_id",
    "decision_id",
    "model_version",
    "parameter_set_version",
    "engine_version",
    "unit_registry_version",
    "manifest_sha256",
    "synthetic_input_review_id",
    "source_records",
    "interval",
    "initial_state",
    "parameters",
    "forcing",
    "heater",
    "condensation_policy",
    "integration",
    "steps"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"trace_sequence_index": {"const": 0}}, "required": ["trace_sequence_index"]},
      "then": {
        "properties": {
          "initial_state": {
            "properties": {
              "temperature": {"$ref": "#/$defs/sourced_K__positive"},
              "humidity_ratio": {"$ref": "#/$defs/sourced_kg_v_kg_da_nonnegative"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "initial_state": {
            "properties": {
              "temperature": {"$ref": "#/$defs/carried_K"},
              "humidity_ratio": {"$ref": "#/$defs/carried_kg_v_kg_da"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "initial_K": {
      "oneOf": [
        {"$ref": "#/$defs/sourced_K__positive"},
        {"$ref": "#/$defs/carried_K"}
      ]
    },
    "initial_kg_v_kg_da": {
      "oneOf": [
        {"$ref": "#/$defs/sourced_kg_v_kg_da_nonnegative"},
        {"$ref": "#/$defs/carried_kg_v_kg_da"}
      ]
    },
    "carried_K": {
      "type": "object",
      "properties": {
        "value": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"const": "K"},
        "origin": {"const": "derived"},
        "basis_ref": {"type": "string", "pattern": "^trace-sha256:[0-9a-f]{64}#/steps/(0|[1-9][0-9]*)/state_end/temperature$"},
        "version": {"const": "v1"},
        "calculation_rule_ref": {"const": "thermal-state-carry-v1"},
        "calculation_rule_version": {"const": "v1"},
        "previous_trace_id": {"type": "string", "minLength": 1},
        "previous_trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},

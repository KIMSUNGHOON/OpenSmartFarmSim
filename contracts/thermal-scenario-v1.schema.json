{
  "$defs": {
    "UnavailableMarketContext": {
      "additionalProperties": false,
      "properties": {
        "hold_report_id": {
          "title": "Hold Report Id",
          "type": "string"
        },
        "kind": {
          "const": "unavailable",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "hold_report_id"
      ],
      "title": "UnavailableMarketContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_context_id": {
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
      "title": "Decision Context Id",
      "type": "string"
    },
    "evidence_level": {
      "const": "assumed",
      "title": "Evidence Level",
      "type": "string"
    },
    "goal_id": {
      "const": "historical-thermal-replay",
      "title": "Goal Id",
      "type": "string"
    },
    "market_context": {
      "$ref": "#/$defs/UnavailableMarketContext"
    },
    "model_version": {
      "const": "thermal-v1",
      "title": "Model Version",
      "type": "string"
    },
    "origin": {
      "const": "user",
      "title": "Origin",
      "type": "string"
    },
    "parameter_set_version": {
      "const": "synthetic-thermal-parameters-v1",
      "title": "Parameter Set Version",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_revision": {
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
      "title": "Scenario Revision",
      "type": "string"
    },
    "schema_version": {
      "const": "thermal-scenario-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "maxLength": 84,
      "minLength": 84,
      "pattern": "^thermal-snapshot-v1:[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "zone_id": {
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$",
      "title": "Zone Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_revision",
    "tenant_id",
    "snapshot_id",
    "decision_context_id",
    "market_context",
    "zone_id",
    "goal_id",
    "model_version",
    "parameter_set_version",
    "origin",
    "evidence_level"
  ],
  "title": "ThermalScenario",
  "type": "object"
}
